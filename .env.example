# Copy to .env.local and fill in values.
#
# Firestore layout (no stickerka root):
#   - stickers     → top-level collection; each document = one sticker (title, categories[], image_source, image_thumbnail)
#   - app_config   → documents: checkouts { checkouts: [] }, blog { posts: [] }
#   - custom_sticker_uploads → metadata for user uploads (downloadURL, storagePath, mimeType, sizeBytes, createdAt)
#
# Storage: uploads go to `custom-stickers/{uuid}/{filename}`. Allow unauthenticated writes only for that path
# (or auth) in Firebase Storage rules, or uploads will fail in production.
#
# Migrate old data: copy each item from stickerka/products.products[] into a new doc in `stickers`
# (Firebase console or script). Optionally copy stickerka/checkouts → app_config/checkouts, etc.

# Firebase (from Project settings)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASURMENT_ID=

# Used by server fetches (API routes, ISR)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
API_SECRET_KEY=
